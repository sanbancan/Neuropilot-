# ─────────────────────────────────────────────────────────────────────────────
# NeuroPilot environment
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values you have.
#
# Every variable is optional. With none set, NeuroPilot runs in demo mode:
# an in-memory mirror of the knowledge graph serves retrieval, and plans are
# built deterministically from that graph context.

# ── Neo4j Aura ───────────────────────────────────────────────────────────────
# Server-side only — never exposed to the browser.
# URI format for Aura: neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# ── LLM (NeuroPilot BCI Systems Architect) ───────────────────────────────────
# Server-side only — never exposed to the browser.
# Without a key, the deterministic fallback generates plans from the graph.
# Example model: gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=
