# Copy to .env.local. All values are server-side; never use NEXT_PUBLIC_ for keys.
# With no OpenAI key and AI_PROVIDER=openai (the default), offline/demo mode remains available.

# Neo4j (unchanged). Missing credentials use the disclosed offline catalog.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Choose mia21 or openai. This selection is explicit: failures never switch providers.
AI_PROVIDER=openai
# Mia21: required, use an exact ID from `npm run ai:models` (GPT, Claude or Gemini).
# Direct OpenAI: optional override; otherwise OPENAI_MODEL or gpt-4o-mini.
AI_MODEL=
MIA21_API_KEY=

# Direct OpenAI rollback / legacy configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional EXACT-MODEL compatibility override. Empty = conservative built-in profile.
# Mia21 defaults to JSON prompting, omitted temperature, 4096 output tokens.
# Reasoning GPT models use max_completion_tokens; other families use max_tokens.
# Override parameters here if the selected Mia21 model requires different settings.
# JSON modes require verifiedOutputModes as an explicit operator attestation after evaluation.
# Example (replace the model ID; do not assume it is currently offered):
# AI_MODEL_PROFILE={"model":"anthropic/your-discovered-claude-id","tokenParameter":"max_tokens","maxOutputTokens":4096,"temperature":null,"outputMode":"prompt"}
# JSON mode example AFTER separate model evaluation:
# AI_MODEL_PROFILE={"model":"your-exact-discovered-id","outputMode":"json_object","verifiedOutputModes":["json_object"]}
AI_MODEL_PROFILE=

# No memory/user/space/conversation variables are supported in Phase 3.
# Mia21 requests always send X-Incognito: true. No initialize/memory APIs are called.
